# Server Port
PORT=3000

# Local LLM configuration (oMLX, Ollama, LM Studio, etc.)
# If running in Docker (OrbStack), localhost/127.0.0.1 is automatically mapped to your host Mac.
LOCAL_LLM_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_API_KEY=

# Leave blank to automatically use whichever model is currently active/loaded in oMLX:
LOCAL_LLM_MODEL=

# Cloud Providers (optional)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
